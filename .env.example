# Create a bot with @BotFather and paste its token here.
BOT_TOKEN=
# Bot username without the @ sign; enables personal referral links.
BOT_USERNAME=

# Public HTTPS address where Telegram can open the Mini App.
APP_URL=https://your-domain.example

# Set to production when deploying behind an HTTPS reverse proxy.
APP_ENV=development
HOST=127.0.0.1
PORT=8080
DATABASE_PATH=data/znakoboom.sqlite3
